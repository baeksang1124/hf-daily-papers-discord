# 이 파일을 .env 로 복사해서 채워넣어 (cp .env.example .env)
# 스크립트는 .env 를 직접 읽지 않으므로 실행 전에 환경변수로 불러와야 함:
#   set -a; source .env; set +a

# (필수) 디스코드 채널 설정 > 연동 > 웹후크 > URL 복사
DISCORD_WEBHOOK_URL=

# 번역용 Anthropic API 키 (없으면 영어 원문 그대로 전송)
ANTHROPIC_API_KEY=

# "0"이면 번역 건너뜀. 기본 1
HF_TRANSLATE=1

# 번역 모델. 기본 claude-haiku-4-5-20251001
HF_MODEL=claude-haiku-4-5-20251001
